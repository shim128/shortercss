{
  "name": "shortercss",
  "version": "2.1.2",
  "description": "An Open Source Solution for shortening/obfuscating CSS selectors",
  "keywords": [
    "class-names",
    "compress",
    "css",
    "minify",
    "obfuscate",
    "selectors",
    "styles"
  ],
  "homepage": "https://github.com/shim128/shortercss",
  "bugs": "https://github.com/shim128/shortercss/issues",
  "license": "MIT",
  "author": {
    "name": "Matb85"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shim128/shortercss.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./processors/*": {
      "types": "./dist/processors/*.d.ts",
      "default": "./dist/processors/*.js"
    },
    "./dist/processors/*": "./dist/processors/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "typecheck": "tsc --noEmit",
    "test": "vp test",
    "coverage": "vp test --coverage",
    "release": "commit-and-tag-version",
    "prepack": "vp pack",
    "test:dist": "node test/compat/smoke.cjs && node test/compat/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "commit-and-tag-version": "^13.3.0",
    "publint": "^0.3.25",
    "typescript": "^7.0.2",
    "vite-plus": "1.3.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@12.14.0"
}
