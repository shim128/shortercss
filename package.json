{
  "name": "shortercss",
  "description": "An Open Source Solution for shortening/obfuscating CSS selectors",
  "version": "2.1.2",
  "main": "./dist/index.js",
  "types": "index.d.ts",
  "scripts": {
    "build": "tsc",
    "gulp": "gulp --gulpfile ./test/example/gulpfile.js",
    "run": "npm run build && npm run gulp",
    "test": "vows --spec",
    "coverage": "istanbul cover ./node_modules/vows/bin/vows --spec",
    "codeclimate": "cat ./coverage/lcov.info | codeclimate",
    "test-report": "npm run coverage && npm run codeclimate",
    "release": "standard-version"
  },
  "dependencies": {
    "app-root-path": "^3.1.0",
    "lodash": "~4.18.1",
    "multimatch": "^8.0.0"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.26",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitest/coverage-v8": "5.0.5",
    "codeclimate-test-reporter": "^0.5.1",
    "eslint": "^10.13.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^7.3.0",
    "gulp": "^5.0.1",
    "istanbul": "^0.4.5",
    "jscoverage": "^0.6.0",
    "standard-version": "^9.5.0",
    "typescript": "^7.0.2",
    "vite-plus": "1.3.0",
    "vows": "^0.8.3"
  },
  "author": {
    "name": "Matb85"
  },
  "homepage": "https://github.com/Matb85/shortercss",
  "bugs": "https://github.com/Matb85/shortercss/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/Matb85/shortercss.git"
  },
  "keywords": [
    "gulp",
    "gulpplugin",
    "munch",
    "minify",
    "css",
    "selectors",
    "terse",
    "terser",
    "styles",
    "compress"
  ],
  "license": "MIT",
  "readmeFilename": "README.md"
}
